<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.north30.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>erp-base</artifactId>
    <packaging>jar</packaging>

    <name>erp-base</name>
    <description>基础数据模块：物料、BOM、客户、供应商等主数据（仅依赖 erp-common）</description>

    <dependencies>
        <dependency>
            <groupId>me.north30.erp</groupId>
            <artifactId>erp-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- MP 扩展：Page 分页（版本由父工程 dependencyManagement 管控，与 erp-system 一致） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <!-- MapStruct 运行时注解（显式声明，模块自洽，版本由父工程管控） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- springdoc 注解（@Operation/@ParameterObject 等，版本由父工程 dependencyManagement 管控） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
        </dependency>
        <!-- 单元测试：JUnit 5 + Mockito + AssertJ（erp-common 的 starter-test 为 test scope，
             Maven test scope 依赖不具传递性，本模块测试需自行声明，版本由 Boot BOM 管控） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- 顺序强制：lombok → lombok-mapstruct-binding → mapstruct-processor，
                             顺序错误会生成空实现（字段全 null）且编译不报错 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Mockito 启动期静态挂载：消除 inline-mock-maker 动态 attach 的 JDK 警告，
                 并兼容未来 JDK 默认禁止动态 agent 的行为。
                 dependency-plugin 的 properties 目标先把 mockito-core 解析为本地仓库路径属性，
                 surefire 再通过坐标式占位符引用（mockito 经 starter-test 传递引入，版本由 Boot 托管） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mockito-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
