<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.north30.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>erp-common</artifactId>
    <packaging>jar</packaging>

    <name>erp-common</name>
    <description>公共组件模块：统一响应体、异常处理、审计切面、通用工具（不依赖任何业务模块）</description>

    <dependencies>
        <!-- Web 能力：统一响应体 / 全局异常处理器依赖 spring-web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- AOP 能力：审计日志切面（Boot 4 中 starter-aop 已更名为 starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- 参数校验：全局异常处理器需处理校验异常 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatis-Plus 注解：BaseEntity 的 @TableId/@TableLogic/@Version 等注解 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <!-- MyBatis 核心：注解默认值引用 org.apache.ibatis.type.JdbcType，编译期需要可见 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>
        <!-- JWT：NimbusJwtEncoder/Decoder 签发与解析（仅 jose 库，不引入 security starter，禁用 jjwt） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!-- MapStruct 运行时注解：全模块对象转换基础（版本由父工程管控） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <!-- 持久层异常语义：UpdateGuardUtil 抛 OptimisticLockingFailureException（409 乐观锁冲突） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- Lombok：代码生成工具（编译期提供，不引入运行时依赖） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试依赖：测试环境使用，不引入运行时依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Mockito 启动期静态挂载：消除 inline-mock-maker 动态 attach 的 JDK 警告，
                 并兼容未来 JDK 默认禁止动态 agent 的行为。
                 dependency-plugin 的 properties 目标先把 mockito-core 解析为本地仓库路径属性，
                 surefire 再通过坐标式占位符引用（mockito 经 starter-test 传递引入，版本由 Boot 托管） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mockito-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
