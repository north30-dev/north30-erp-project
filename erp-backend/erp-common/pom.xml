<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.north30.erp</groupId>
        <artifactId>erp-backend</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>erp-common</artifactId>
    <packaging>jar</packaging>

    <name>erp-common</name>
    <description>公共组件模块：统一响应体、异常处理、审计切面、通用工具（不依赖任何业务模块）</description>

    <dependencies>
        <!-- Web 能力：统一响应体 / 全局异常处理器依赖 spring-web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- AOP 能力：审计日志切面（Boot 4 中 starter-aop 已更名为 starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- 参数校验：全局异常处理器需处理校验异常 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatis-Plus 注解：BaseEntity 的 @TableId/@TableLogic/@Version 等注解（不引入 MP 核心） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
